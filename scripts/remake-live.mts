try{
 if(!s.get('catalog-product','product-9c05979e-6ea4-4216-81ea-0ebfa327a12d')){const db=new DatabaseSync(path.join(root,'data/studio.sqlite'),{readOnly:true});const read=(kind:string,id:string)=>JSON.parse(db.prepare('SELECT value FROM documents WHERE kind=? AND id=?').get(kind,id)!.value as string);const p=read('catalog-product','product-9c05979e-6ea4-4216-81ea-0ebfa327a12d') as CatalogProduct;s.put('catalog-product',p.id,p);fs.cpSync(path.join(root,'data/private'),path.join(data,'private'),{recursive:true});for(const b of p.bindings.filter(b=>b.kind==='main').slice(0,2)){const a=read('asset',b.assetId) as Asset;fs.copyFileSync(path.join(root,'data/media',path.basename(a.url)),path.join(data,'media',path.basename(a.url)));s.put('asset',a.id,a);}s.put('analysis-model','tt-6.1-sol',read('analysis-model','tt-6.1-sol'));db.close();const filename='source-live-coat.mp4';fs.copyFileSync(path.join(root,'output/catalog-live-20261029/media/provider-attempt-d5549957-4593-48f8-93d5-7242683c1f2e.mp4'),path.join(data,'media',filename));s.put('asset','remake-live-source',{id:'remake-live-source',type:'video',mime:'video/mp4',url:'/media/'+filename,bytes:fs.statSync(path.join(data,'media',filename)).size,source:'upload',createdAt:new Date().toISOString()});}
