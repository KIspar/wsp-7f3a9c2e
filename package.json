{
  "name": "ai-creative-studio",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch apps/server/index.ts",
    "build": "tsc --noEmit && vite build && tsup",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/smoke.mjs && node scripts/pricing-smoke.mjs && node scripts/analysis-smoke.mjs && node scripts/provider-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/prepare-assets.mjs",
    "test:research": "vitest run tests/research.test.ts tests/research-flow.test.ts tests/research-extension-flow.test.ts",
    "test:research:e2e": "npm run build && node scripts/research-flow-e2e.mjs"
  },
  "dependencies": {
    "@animate-ui/react": "2.4.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.16",
    "@tanstack/react-query": "^5.90.5",
    "@xyflow/react": "^12.12.1",
    "archiver": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "fastify": "^5.6.1",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.468.0",
    "motion": "14.10.1",
    "playwright": "1.64.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "4.19.1",
    "react-router-dom": "^7.9.4",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
